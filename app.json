{
  "expo": {
    "name": "Vone Trucking",
    "slug": "vone-trucking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vonetrucking.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A237E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.vonetrucking.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A237E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03ec9c6f-a234-458f-a203-485673848e57"
      }
    },
    "owner": "josephinesantander"
  }
}
